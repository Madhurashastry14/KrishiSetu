{
  "name": "krishisetu",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace client\" \"npm:dev --workspace server\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
