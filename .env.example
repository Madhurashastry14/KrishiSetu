DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/krishisetu?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
FAIR_PRICE_GREEN_THRESHOLD=0.95
FAIR_PRICE_AMBER_THRESHOLD=0.80

# Optional data.gov.in Agmarknet resource credentials. Live data is fetched only
# when both values are configured and the resource returns mappable records.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=
