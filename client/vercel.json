{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "YOUR_EXISTING_API_REWRITE_DESTINATION"
    },
    {
      "source": "/uploads/:path*",
      "destination": "YOUR_EXISTING_UPLOADS_REWRITE_DESTINATION"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
